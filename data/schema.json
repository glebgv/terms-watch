{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terms Watch data schema",
  "type": "object",
  "defs": {
    "version": {
      "type": "object",
      "required": ["date", "hash"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "wayback_url": {"type": ["string", "null"], "format": "uri"},
        "text_length": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "change": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "position", "text"],
          "properties": {
            "type": {"enum": ["add", "remove"]},
            "position": {"type": "integer"},
            "text": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["type", "position", "old_text", "new_text", "word_diff"],
          "properties": {
            "type": {"const": "modify"},
            "position": {"type": "integer"},
            "old_text": {"type": "string"},
            "new_text": {"type": "string"},
            "word_diff": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "text"],
                "properties": {
                  "type": {"enum": ["keep", "add", "remove"]},
                  "text": {"type": "string"}
                }
              }
            }
          }
        }
      ]
    },
    "diff": {
      "type": "object",
      "required": ["site", "doc_id", "from_date", "to_date", "from_hash", "to_hash", "stats", "is_major", "keywords", "changes"],
      "properties": {
        "site": {"type": "string"},
        "doc_id": {"type": "string"},
        "doc_title": {"type": "string"},
        "from_date": {"type": "string", "format": "date"},
        "to_date": {"type": "string", "format": "date"},
        "from_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "to_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "url": {"type": "string", "format": "uri"},
        "stats": {
          "type": "object",
          "required": ["lines_added", "lines_removed", "lines_changed", "change_ratio"],
          "properties": {
            "lines_added": {"type": "integer"},
            "lines_removed": {"type": "integer"},
            "lines_changed": {"type": "integer"},
            "change_ratio": {"type": "number", "minimum": 0}
          }
        },
        "is_major": {"type": "boolean"},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "changes": {"type": "array", "items": {"$ref": "#/defs/change"}},
        "ai_summary": {"type": "string"}
      }
    }
  },
  "properties": {
    "sites": {
      "type": "object",
      "required": ["sites"],
      "properties": {
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "url", "docs"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "category": {"type": "string"},
              "added": {"type": "string", "format": "date"},
              "active": {"type": "boolean"},
              "docs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["doc_id", "url"],
                  "properties": {
                    "doc_id": {"type": "string"},
                    "title": {"type": "string"},
                    "url": {"type": "string", "format": "uri"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "required": ["versions"],
      "properties": {
        "versions": {"type": "array", "items": {"$ref": "#/defs/version"}}
      }
    },
    "diff_file": {"$ref": "#/defs/diff"},
    "changelog": {
      "type": "object",
      "required": ["updated", "entries"],
      "properties": {
        "updated": {"type": "string"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "site_id", "site_name", "summary"],
            "properties": {
              "date": {"type": "string", "format": "date"},
              "checked_at": {"type": "string"},
              "site_id": {"type": "string"},
              "site_name": {"type": "string"},
              "doc_id": {"type": "string"},
              "doc_title": {"type": "string"},
              "is_major": {"type": "boolean"},
              "keywords": {"type": "array", "items": {"type": "string"}},
              "summary": {"type": "string"},
              "url": {"type": "string"},
              "diff_url": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
